# Salin ke .env.local untuk pengembangan lokal.
# Di Vercel, isi lewat Settings → Environment Variables (atau otomatis dari integrasi).
# Cara tercepat menarik nilai yang sudah ada di Vercel:  vercel env pull .env.local

# --- Neon Postgres ---------------------------------------------------------
# Diisi otomatis oleh integrasi Neon / Vercel Postgres.
# Aplikasi menerima salah satu dari: DATABASE_URL, POSTGRES_URL,
# DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Vercel Blob -----------------------------------------------------------
# Diisi otomatis saat Blob store disambungkan ke proyek.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxx
# Opsional, default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Autodesk Platform Services (konversi DWG) -----------------------------
# Dari https://aps.autodesk.com → Applications → aplikasi Anda.
# Butuh akun berbayar; DWG adalah format tertutup dan tidak bisa dibaca
# pustaka JavaScript mana pun, jadi konversinya harus lewat Autodesk.
APS_CLIENT_ID=xxxxxxxx
APS_CLIENT_SECRET=xxxxxxxx
# Opsional. Bila kosong, nama bucket diturunkan dari APS_CLIENT_ID.
# APS_BUCKET=bio-district-gambar

# --- Pembuatan tabel -------------------------------------------------------
# Nilai acak bebas. Melindungi POST /api/setup yang menjalankan DDL.
SETUP_SECRET=ganti-dengan-nilai-acak
